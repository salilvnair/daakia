{
  "name": "daakia",
  "displayName": "Daakia — API Client",
  "description": "A modern API testing extension for VS Code with AI assistant, collections, environments, and mock servers.",
  "version": "2.0.4",
  "license": "MIT",
  "publisher": "salilvnair",
  "repository": {
    "type": "git",
    "url": "https://github.com/salilvnair/daakia"
  },
  "icon": "images/daakia-icon.png",
  "galleryBanner": {
    "color": "#0f0f0f",
    "theme": "dark"
  },
  "changelog": "CHANGELOG.md",
  "categories": [
    "Testing",
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "api",
    "rest",
    "http",
    "postman",
    "graphql",
    "soap",
    "grpc",
    "websocket",
    "mqtt",
    "mock",
    "collections",
    "openapi",
    "swagger",
    "ai",
    "mcp",
    "copilot"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "daakia.copilot",
        "name": "daakia",
        "fullName": "Daakia Assistant",
        "description": "AI-powered API assistant — build requests, debug responses, generate tests",
        "isSticky": true,
        "commands": [
          {
            "name": "request",
            "description": "Build an API request from description"
          },
          {
            "name": "mock",
            "description": "Create a mock server endpoint"
          },
          {
            "name": "test",
            "description": "Generate test scripts for current request"
          },
          {
            "name": "curl",
            "description": "Convert a cURL command to Daakia request"
          },
          {
            "name": "explain",
            "description": "Explain an HTTP status code or header"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "daakia",
          "title": "Daakia",
          "icon": "images/daakia-side.svg"
        }
      ]
    },
    "views": {
      "daakia": [
        {
          "id": "daakia.welcome",
          "name": "Daakia",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [],
    "commands": [
      {
        "command": "daakia.openPanel",
        "title": "Daakia: Open Panel",
        "icon": "$(window)"
      },
      {
        "command": "daakia.newRequest",
        "title": "Daakia: New Request",
        "icon": "$(add)"
      },
      {
        "command": "daakia.sendRequest",
        "title": "Daakia: Send Request",
        "icon": "$(play)"
      },
      {
        "command": "daakia.saveRequest",
        "title": "Daakia: Save Request",
        "icon": "$(save)"
      },
      {
        "command": "daakia.closeTab",
        "title": "Daakia: Close Tab"
      },
      {
        "command": "daakia.focusUrl",
        "title": "Daakia: Focus URL Bar"
      },
      {
        "command": "daakia.openCommandPalette",
        "title": "Daakia: Open Command Palette"
      },
      {
        "command": "daakia.importCollection",
        "title": "Daakia: Import Collection",
        "icon": "$(cloud-download)"
      },
      {
        "command": "daakia.importBrunoCollection",
        "title": "Daakia: Import Bruno Collection",
        "icon": "$(folder-opened)"
      },
      {
        "command": "daakia.importDaakiaCollection",
        "title": "Daakia: Import Collection (Daakia JSON)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "daakia.openSettings",
        "title": "Daakia: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "daakia.startMockServer",
        "title": "Daakia: Start Mock Server"
      },
      {
        "command": "daakia.stopMockServer",
        "title": "Daakia: Stop Mock Server"
      },
      {
        "command": "daakia.start",
        "title": "Daakia: Open"
      },
      {
        "command": "daakia.changeDbLocation",
        "title": "Daakia: Change Database Location"
      },
      {
        "command": "daakia.rebuildSqlite",
        "title": "Daakia: Rebuild SQLite"
      },
      {
        "command": "daakia.exportCollectionsToWorkspace",
        "title": "Daakia: Export Collections to Workspace (Git Sync)"
      },
      {
        "command": "daakia.importCollectionsFromWorkspace",
        "title": "Daakia: Import Collections from Workspace (Git Sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "daakia.openPanel",
          "when": "view == daakia.welcome",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "daakia.sendRequest",
        "key": "ctrl+enter",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      },
      {
        "command": "daakia.newRequest",
        "key": "ctrl+n",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      },
      {
        "command": "daakia.saveRequest",
        "key": "ctrl+s",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      },
      {
        "command": "daakia.closeTab",
        "key": "ctrl+w",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      },
      {
        "command": "daakia.importCollection",
        "key": "ctrl+shift+i",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      },
      {
        "command": "daakia.focusUrl",
        "key": "ctrl+l",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      },
      {
        "command": "daakia.openCommandPalette",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeWebviewPanelId == 'daakia.mainPanel'"
      }
    ],
    "configuration": {
      "title": "Daakia",
      "properties": {
        "daakia.dbPath": {
          "type": "string",
          "default": "",
          "description": "Custom path for the Daakia SQLite database. Leave empty for default (~/.salilvnair/daakia-vsce/db/daakia.db)."
        },
        "daakia.requestTimeout": {
          "type": "number",
          "default": 0,
          "description": "Default request timeout in milliseconds. 0 = no timeout (infinite)."
        },
        "daakia.followRedirects": {
          "type": "boolean",
          "default": true,
          "description": "Automatically follow HTTP redirects."
        },
        "daakia.sslVerification": {
          "type": "boolean",
          "default": true,
          "description": "Verify SSL certificates for HTTPS requests."
        },
        "daakia.maxHistoryEntries": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of request history entries to keep."
        },
        "daakia.saveResponseInHistory": {
          "type": "boolean",
          "default": true,
          "description": "Store response body in history entries."
        },
        "daakia.gitSync.autoSyncSeconds": {
          "type": "number",
          "enum": [0, 1, 5, 10, 30],
          "default": 0,
          "description": "Auto sync interval in seconds (0 = off). When on, runs a full export → commit → pull → push → import cycle of collections, history, mock servers, and state machine workflows on this interval."
        },
        "daakia.gitSync.remoteUrl": {
          "type": "string",
          "default": "",
          "description": "SSH remote URL for the git-sync folder, e.g. git@github.com:org/repo.git. Auth is handled entirely by your system git/ssh-agent — Daakia never touches SSH keys itself."
        },
        "daakia.gitSync.branch": {
          "type": "string",
          "default": "main",
          "description": "Branch to push/pull for git sync."
        },
        "daakia.gitSync.syncHistory": {
          "type": "boolean",
          "default": true,
          "description": "Include request history in git sync."
        },
        "daakia.gitSync.syncCollections": {
          "type": "boolean",
          "default": true,
          "description": "Include collections in git sync."
        },
        "daakia.gitSync.syncMockServers": {
          "type": "boolean",
          "default": true,
          "description": "Include mock server configs and their state machine workflows in git sync."
        },
        "daakia.gitSync.syncEnvironments": {
          "type": "boolean",
          "default": true,
          "description": "Include environments in git sync. Variables flagged as secret are never written to disk — only the variable key is synced, the value is redacted."
        },
        "daakia.gitSync.syncAiConfig": {
          "type": "boolean",
          "default": true,
          "description": "Include the prompt library, AI feature flags, and AI provider config (not API keys — those stay in your OS keychain) in git sync."
        }
      }
    },
    "icons": {
      "daakia-icon": {
        "description": "Daakia icon",
        "default": {
          "fontPath": "./images/daakia-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "typecheck": "tsc --noEmit -p tsconfig.json && cd webview-ui && npx tsc --noEmit",
    "build:all": "npm run typecheck && npm run build:webview && npm run build:ext",
    "build:ext": "node esbuild.js",
    "build:webview": "cd webview-ui && node node_modules/vite/bin/vite.js build",
    "watch": "node esbuild.js --watch",
    "dev:webview": "cd webview-ui && node node_modules/vite/bin/vite.js",
    "lint": "eslint src/ --ext .ts",
    "backup": "node scripts/zip_daakia_latest.js",
    "audit:ai-handlers": "node scripts/audit-ai-message-contracts.mjs",
    "heap:parse": "node dist/heap-worker.js",
    "heap:verify": "node dist/heap-worker.js src/test/fixtures/heap/out/leak.hprof --verify src/test/fixtures/heap/out/leak.truth.json",
    "heap:gate": "node src/test/fixtures/heap/gate.test.mjs",
    "heap:bench": "node --expose-gc src/test/fixtures/heap/bench.mjs",
    "heap:verify:grown": "node dist/heap-worker.js src/test/fixtures/heap/out/grown.hprof --verify src/test/fixtures/heap/out/grown.truth.json",
    "heap:growth": "node src/test/fixtures/heap/growth.test.mjs",
    "heap:check": "node cli/daakia-heap-check.mjs",
    "heap:rules": "node src/test/fixtures/heap/rules.test.mjs",
    "threads:verify": "node src/test/fixtures/threads/threads.test.mjs",
    "logs:verify": "node src/test/fixtures/logs/logs.test.mjs",
    "proxy:verify": "node src/test/fixtures/proxy/proxy.test.mjs",
    "audit:verify": "node src/test/fixtures/audit/audit.test.mjs",
    "session:verify": "node src/test/fixtures/audit/session.test.mjs",
    "heap:all": "npm run heap:verify && npm run heap:verify:grown && npm run heap:growth && npm run heap:gate && npm run heap:rules && npm run threads:verify && npm run logs:verify && npm run proxy:verify && npm run audit:verify && npm run session:verify",
    "vscode:package": "vsce package",
    "vscode:publish": "vsce publish",
    "vscode:publish:patch": "vsce publish patch",
    "vscode:publish:minor": "vsce publish minor",
    "vscode:publish:major": "vsce publish major",
    "test:e2e": "node out/test/runTests.js",
    "pretest:e2e": "npm run build:ext && tsc -p tsconfig.test.json",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:webview": "cd webview-ui && npx vitest run",
    "run:collection": "node cli/daakia-run.mjs",
    "local-server:build": "node local-server/build.js",
    "local-server:watch": "node local-server/build.js --watch",
    "local-server": "npm run local-server:build && node local-server/dist/server.js",
    "demo-video:record": "node scripts/demo-video/record.js",
    "demo-video:compose": "node scripts/demo-video/compose.js",
    "demo-video": "npm run demo-video:record && npm run demo-video:compose",
    "showcase": "npm run demo-video:record && node scripts/demo-video/compose.js --gif"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.15",
    "@salilvnair/state-machine": "^1.0.1",
    "aedes": "^1.0.2",
    "axios": "^1.7.0",
    "fast-xml-parser": "^5.8.0",
    "js-yaml": "^4.1.1",
    "mqtt": "^5.15.1",
    "path-to-regexp": "^8.0.0",
    "protobufjs": "^7.6.1",
    "soap": "^1.9.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.14.1",
    "uuid": "^10.0.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.99.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "esbuild": "^0.24.0",
    "express": "^5.2.1",
    "glob": "^11.0.0",
    "mocha": "^10.4.0",
    "playwright": "^1.62.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
