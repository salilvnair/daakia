{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "@daakia/dk8s-prompts": ["../src/panel/chat/dk8s-prompts.ts"],
      "@daakia/log-format": ["../src/services/k8s/log-format.ts"],
      "@daakia/pv-layouts": ["../src/services/k8s/pv-layouts.ts"]
    }
  },
  "include": [
    "src",
    "../src/panel/chat/dk8s-prompts.ts",
    "../src/services/k8s/log-format.ts",
    "../src/services/k8s/pv-layouts.ts"
  ]
}
