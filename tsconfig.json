{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"types": ["node", "mocha"]
	},
	"exclude": [
		"node_modules",
		"webview-ui",
		"vite.webview.config.ts",
		"webview",
		"local-server",
		"**/*.test.ts"
	]
}
